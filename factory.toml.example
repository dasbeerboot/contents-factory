# `factory init --os macos|windows|linux` writes the os key above; omitting the flag
# records what this machine looks like and asks you to confirm. The scheduler, the Naver
# backend and the credentials file permissions all read it.
ui_lang = "ko"
content_lang = "en"
default_profile = "_example"
home = "~/.contents-factory"
review = "terminal"

# Extra repeat_guard corpus files, keyed by profile ("*" = every profile). Point these at
# the post history of whatever pipeline this profile is taking over from; otherwise the
# guard only knows this factory's own published items and every already-burned phrase
# reads as fresh. .jsonl (one object per line), .json ({"items": [...]} or a list) and
# plain text are all accepted; rows need a `text` field and ideally `published_at`.
# [extra_corpus]
# "*"     = []
# someone = ["~/.other-pipeline/posts.jsonl"]
